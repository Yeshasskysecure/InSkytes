# Search and AI backend environment template.
# Do not put real secrets in this file. Copy to config/search.env locally or
# store these values in Key Vault/App Service settings for deployed backends.
#
# Important: this SPFx frontend does not safely consume these values directly.
# Admin keys, query keys, Graph secrets, OpenAI keys, and Document Intelligence
# keys must stay in backend/worker runtime configuration only.

# Optional frontend runtime config value. This is not a secret. It points SPFx
# to the secure search/chat API once that backend URL is approved.
KNOWLEDGE_SEARCH_API_BASE_URL=

# Microsoft Graph / Entra app-only auth
GRAPH_TENANT_ID=547b64a7-e66e-48df-a146-3e898cbcb60f
GRAPH_CLIENT_ID=f9403a61-d04e-46cf-a5d1-cbc68a66f740
GRAPH_CLIENT_SECRET=
GRAPH_SCOPE=https://graph.microsoft.com/.default

# SharePoint source locations
SHAREPOINT_HOSTNAME=skysecuretech.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/InSkytes
SHAREPOINT_SITE_ID=skysecuretech.sharepoint.com,9d3cf7ea-0b61-4ad9-8780-433625ec6a6f,900862b0-5891-47d9-9ac2-83afc691e3c8
SHAREPOINT_LIBRARY_LIST_ID=6c9e04e6-f646-4f5b-a610-94e2eeb07998
SHAREPOINT_LIBRARY_DRIVE_ID=b!6vc8nWEL2UqHgEM2Jexqb7BiCJCRWNlHmsKDr8aR48jmBJ5sRvZbT6YQlOLusHmY
SHAREPOINT_LIBRARY_WEB_URL=https://skysecuretech.sharepoint.com/sites/InSkytes/KM%20Review%20Hub/Forms/AllItems.aspx
SHAREPOINT_LIBRARY_NAME=KM Review Hub
SHAREPOINT_WHOSWHO_LIST_ID=
SHAREPOINT_WHOSWHO_WEB_URL=
SHAREPOINT_WHOSWHO_LIST_NAME=

# SharePoint column mapping
SP_FIELD_FILE_NAME=FileLeafRef
SP_FIELD_TITLE=Title
SP_FIELD_DESCRIPTION=_ExtendedDescription
SP_FIELD_AUTHOR=Author0
SP_FIELD_PUBLISHED=Published
SP_FIELD_CONTENT_REFRESH_DATE=ContentRefreshDate
SP_FIELD_URL=URL
SP_FIELD_STATUS=Status
SP_FIELD_VIEWS=Views
SP_FIELD_LIKES=Likes
SP_FIELD_COMMENTS=Comments
SP_FIELD_DOWNLOADS=Downloads
SP_FIELD_FOLLOW=Follow
SP_FIELD_SHARE=Share
SP_FIELD_BOOKMARK=Bookmark
SP_FIELD_SENSITIVE_TERMS=SensitiveTerms
SP_FIELD_REVIEWER_COMMENTS=ReviewerComments
SP_FIELD_PROJECT_ID=ProjectId
SP_FIELD_VERSION_FILE_NAME=VersionFileName
SP_FIELD_VERSION_FILE_TYPE=VersionFileType
SP_FIELD_DOCUMENT_TYPE=Document_x0020_Type
SP_FIELD_GEOGRAPHY=Geography
SP_FIELD_CLIENT=Client
SP_FIELD_DISEASE_AREA=Disease_x0020_Area
SP_FIELD_THERAPY_AREA=Therapy_x0020_Area
SP_FIELD_BU=BU
SP_FIELD_DEPARTMENT=Department_x0020__x002f__x0020_Sub_x0020_Department
SP_FIELD_CREATED=Created
SP_FIELD_MODIFIED=Modified
SP_FIELD_CREATED_BY=Author
SP_FIELD_MODIFIED_BY=Editor
SP_FIELD_VERSION=Version

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_VERSION=2025-09-01
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_QUERY_KEY=
AZURE_SEARCH_DOCUMENTS_INDEX=km-documents-index
AZURE_SEARCH_CHUNKS_INDEX=km-chunks-index
AZURE_SEARCH_PEOPLE_INDEX=km-people-index
AZURE_SEARCH_VECTOR_PROFILE=km-hnsw-vector-profile
AZURE_SEARCH_VECTOR_ALGORITHM=km-hnsw-cosine
AZURE_SEARCH_SEMANTIC_CONFIG=chunks-semantic-config
AZURE_SEARCH_VECTOR_FIELD=chunkVector
AZURE_SEARCH_VECTOR_DIMENSIONS=3072
AZURE_SEARCH_DEFAULT_TOP=25
AZURE_SEARCH_CHAT_TOP=8
AZURE_SEARCH_CHAT_DOCUMENT_TOP=6
AZURE_SEARCH_CHAT_PEOPLE_TOP=4
AZURE_SEARCH_CHAT_MIN_RERANKER_SCORE=1
AZURE_SEARCH_GENERIC_MIN_LEXICAL_MATCHES=1
AZURE_SEARCH_SEMANTIC_MIN_RERANKER_SCORE=2
AZURE_SEARCH_SEMANTIC_STRONG_RERANKER_SCORE=3
AZURE_SEARCH_SEMANTIC_MIN_LEXICAL_MATCHES=1
AZURE_SEARCH_HYBRID_K=50
AZURE_SEARCH_REQUIRE_ACTIVE_FILTER=true

# Full library sync batching. Keep these conservative for local runs; increase
# only after validating Azure Search/OpenAI throttling and memory usage.
SYNC_FLUSH_EACH_ITEM=true
SYNC_PAGE_SIZE=50
SYNC_CONCURRENCY=3
SYNC_EMBEDDING_MIN_DELAY_MS=15000
SYNC_EMBEDDING_BATCH_SIZE=5
SYNC_CHECKPOINT_EVERY=1
SYNC_PAUSE_BETWEEN_ITEMS_MS=0
SYNC_PEOPLE_TOP=500
SYNC_DOCUMENT_UPLOAD_BATCH_SIZE=100
SYNC_CHUNK_UPLOAD_BATCH_SIZE=1000
SYNC_REPORT_LIMIT=100

# Azure OpenAI / Azure AI Foundry
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_USE_LEGACY_API=true
AZURE_OPENAI_USE_MAX_COMPLETION_TOKENS=true
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_CHAT_ROUTER_ENABLED=true
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072
AZURE_OPENAI_EMBEDDING_BATCH_SIZE=100
AZURE_OPENAI_WHISPER_ENDPOINT=
AZURE_OPENAI_WHISPER_API_KEY=
AZURE_OPENAI_WHISPER_API_VERSION=2024-06-01
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
AZURE_OPENAI_WHISPER_MODE=transcriptions
SEARCH_UPLOAD_MAX_MEDIA_BYTES=25165824
SEARCH_UPLOAD_METADATA_MAX_CHARS=120000
SEARCH_UPLOAD_TRANSCRIPT_MAX_CHARS=120000

# Extraction strategy
# local-first uses libraries for born-digital files and Document Intelligence
# for OCR/scanned/complex fallback. doc-intel-first sends supported files to
# Document Intelligence by default.
EXTRACTION_STRATEGY=local-first
EXTRACTION_MAX_FILE_MB=100
EXTRACTION_CHUNK_TARGET_TOKENS=750
EXTRACTION_CHUNK_OVERLAP_TOKENS=120
EXTRACTION_SKIP_MEDIA=true
EXTRACTION_SKIP_MEDIA_EXTENSIONS=mp4,m4v,mov,avi,mkv,wmv,mp3,wav,m4a
EXTRACTION_METADATA_ONLY_EXTENSIONS=msg,eml,zip,sketch,idml,indd,ai,ase,psd,eps,ttf,otf,woff,woff2,lst,thmx

# Azure Document Intelligence fallback
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
AZURE_DOC_INTEL_API_VERSION=2024-11-30
AZURE_DOC_INTEL_MODEL=prebuilt-read

# Optional queue and inventory, required before large backfill/delta sync
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_QUEUE_NAME=km-ingestion-jobs
DATABASE_URL=

# Optional Graph webhook support
WEBHOOK_BASE_URL=
GRAPH_WEBHOOK_CLIENT_STATE=
GRAPH_WEBHOOK_RENEWAL_HOURS=48
