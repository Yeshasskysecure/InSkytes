{
  "name": "sharepoint-migration-site",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=18.17.1 <19.0.0"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "gulp bundle",
    "clean": "gulp clean",
    "test": "gulp test",
    "search:build": "tsc -p tools/search-backend/tsconfig.json",
    "search:env:check": "node tools/search-backend/scripts/validate-env.js config/search.env",
    "search:env:check:dev": "node tools/search-backend/scripts/validate-env.js config/search.dev.env",
    "search:types:check": "tsc -p tools/search-backend/tsconfig.json --noEmit",
    "search:inspect": "node tools/search-backend/scripts/inspect-sharepoint.js config/search.env",
    "search:resolve:dev": "node tools/search-backend/scripts/resolve-sharepoint-site.js config/search.env skysecuretech.sharepoint.com /sites/InSkytes \"KM Review Hub\" \"\"",
    "search:resolve:dev:env": "node tools/search-backend/scripts/resolve-sharepoint-site.js config/search.dev.env skysecuretech.sharepoint.com /sites/InSkytes \"KM Review Hub\" \"\"",
    "search:indexes:reset": "node tools/search-backend/scripts/reset-indexes.js config/search.env",
    "search:indexes:reset:dev": "node tools/search-backend/scripts/reset-indexes.js config/search.dev.env",
    "search:indexes:update": "node tools/search-backend/scripts/update-index-schema.js config/search.env",
    "search:indexes:update:dev": "node tools/search-backend/scripts/update-index-schema.js config/search.dev.env",
    "search:backfill": "npm run search:build --silent && node tools/search-backend/scripts/backfill-library.js config/search.env all",
    "search:backfill:dev": "npm run search:build --silent && node tools/search-backend/scripts/backfill-library.js config/search.dev.env all",
    "search:evaluate": "npm run search:build --silent && node tools/search-backend/scripts/evaluate-search.js config/search.env",
    "search:evaluate:dev": "npm run search:build --silent && node tools/search-backend/scripts/evaluate-search.js config/search.dev.env",
    "search:evaluate:chat:brutal": "npm run search:build --silent && node tools/search-backend/scripts/evaluate-search.js config/search.env tools/search-backend/evals/chat-brutal-dev.json",
    "search:evaluate:chat:brutal:dev": "npm run search:build --silent && node tools/search-backend/scripts/evaluate-search.js config/search.dev.env tools/search-backend/evals/chat-brutal-dev.json",
    "search:analyze": "node tools/search-backend/scripts/analyze-library.js",
    "search:analyze:dev": "node tools/search-backend/scripts/analyze-library.js config/search.dev.env 100000",
    "search:delta:init": "node tools/search-backend/scripts/delta-sync.js config/search.env init 25",
    "search:delta:init:dev": "node tools/search-backend/scripts/delta-sync.js config/search.dev.env init 25",
    "search:delta:checkpoint": "node tools/search-backend/scripts/delta-sync.js config/search.env checkpoint all",
    "search:delta:checkpoint:dev": "node tools/search-backend/scripts/delta-sync.js config/search.dev.env checkpoint all",
    "search:delta": "node tools/search-backend/scripts/delta-sync.js config/search.env delta 25",
    "search:delta:dev": "node tools/search-backend/scripts/delta-sync.js config/search.dev.env delta 25",
    "search:delta:catchup": "node tools/search-backend/scripts/delta-sync.js config/search.env delta all",
    "search:delta:catchup:dev": "node tools/search-backend/scripts/delta-sync.js config/search.dev.env delta all",
    "search:delta:watch": "node tools/search-backend/scripts/delta-watch.js config/search.env 180",
    "search:delta:watch:dev": "node tools/search-backend/scripts/delta-watch.js config/search.dev.env 180",
    "search:crud:test:dev": "node tools/search-backend/scripts/crud-sync-test.js config/search.dev.env",
    "search:crud:test:prod-controlled": "node tools/search-backend/scripts/crud-prod-controlled-test.js config/search.env",
    "search:index:stats": "node tools/search-backend/scripts/index-stats.js config/search.env",
    "search:index:stats:dev": "node tools/search-backend/scripts/index-stats.js config/search.dev.env",
    "search:log:summary": "node tools/search-backend/scripts/backfill-log-summary.js",
    "search:webhook:ensure": "node tools/search-backend/scripts/ensure-graph-subscription.js config/search.env ensure",
    "search:webhook:ensure:dev": "node tools/search-backend/scripts/ensure-graph-subscription.js config/search.dev.env ensure",
    "search:webhook:list": "node tools/search-backend/scripts/ensure-graph-subscription.js config/search.env list",
    "search:webhook:list:dev": "node tools/search-backend/scripts/ensure-graph-subscription.js config/search.dev.env list",
    "search:webhook:delete": "node tools/search-backend/scripts/ensure-graph-subscription.js config/search.env delete",
    "search:webhook:delete:dev": "node tools/search-backend/scripts/ensure-graph-subscription.js config/search.dev.env delete",
    "search:purge:nonactive": "node tools/search-backend/scripts/purge-non-active.js config/search.env",
    "search:api:smoke": "npm run search:build --silent && node tools/search-backend/scripts/api-smoke-test.js config/search.env",
    "search:api:smoke:dev": "npm run search:build --silent && node tools/search-backend/scripts/api-smoke-test.js config/search.dev.env",
    "search:facet-contract": "npm run search:build --silent && node tools/search-backend/scripts/validation/filter-facet-contract-check-20260612.js config/search.env",
    "search:facet-contract:dev": "npm run search:build --silent && node tools/search-backend/scripts/validation/filter-facet-contract-check-20260612.js config/search.dev.env",
    "search:upload-ai:smoke": "npm run search:build --silent && node tools/search-backend/scripts/upload-ai-smoke-test.js config/search.env C:\\tmp\\iknowledge-upload-ai-smoke-report.json",
    "search:upload-ai:smoke:dev": "npm run search:build --silent && node tools/search-backend/scripts/upload-ai-smoke-test.js config/search.dev.env C:\\tmp\\iknowledge-upload-ai-smoke-report-dev.json",
    "search:release:gate": "npm run search:env:check --silent && npm run search:api:smoke --silent && npm run search:evaluate:chat:brutal --silent",
    "search:release:gate:dev": "npm run search:env:check:dev --silent && npm run search:api:smoke:dev --silent && npm run search:evaluate:chat:brutal:dev --silent",
    "search:local-api": "npm run search:build --silent && node tools/search-backend/scripts/local-api-server.js config/search.env 7072",
    "search:local-api:dev": "npm run search:build --silent && node tools/search-backend/scripts/local-api-server.js config/search.dev.env 7072",
    "search:api:start": "node tools/search-backend/scripts/local-api-server.js process"
  },
  "dependencies": {
    "tslib": "2.3.1",
    "@microsoft/sp-core-library": "1.20.0",
    "@microsoft/decorators": "1.20.0",
    "@microsoft/sp-dialog": "1.20.0",
    "@microsoft/sp-application-base": "1.20.0",
    "@microsoft/sp-http": "1.20.0",
    "@microsoft/sp-listview-extensibility": "1.20.0",
    "@microsoft/sp-property-pane": "1.20.0",
    "@microsoft/sp-webpart-base": "1.20.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "react-pdf": "^9.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@microsoft/rush-stack-compiler-4.7": "0.1.0",
    "@rushstack/eslint-config": "4.0.1",
    "@microsoft/eslint-plugin-spfx": "1.20.2",
    "@microsoft/eslint-config-spfx": "1.20.2",
    "@microsoft/sp-build-web": "1.20.2",
    "@types/webpack-env": "~1.15.2",
    "ajv": "^6.12.5",
    "eslint": "8.57.0",
    "gulp": "4.0.2",
    "typescript": "4.7.4",
    "@microsoft/sp-module-interfaces": "1.20.2"
  }
}
